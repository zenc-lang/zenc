// test_bigint
import "std/bigint.zc"

test "BigInt New and FromInt" {
    let zero = BigInt::new();
    let zs = zero.to_string();
    assert(zs[0] == '0' && zs[1] == 0, "zero string");
    free(zs);

    let b = BigInt::from_int(0);
    let bs = b.to_string();
    assert(bs[0] == '0' && bs[1] == 0, "from_int(0) string");
    free(bs);
}

test "BigInt FromInt Values" {
    let b = BigInt::from_int(12345);
    let s = b.to_string();
    assert(s[0] == '1', "digit 1");
    assert(s[1] == '2', "digit 2");
    assert(s[2] == '3', "digit 3");
    assert(s[3] == '4', "digit 4");
    assert(s[4] == '5', "digit 5");
    free(s);
}

test "BigInt Add" {
    let a = BigInt::from_int(123);
    let b = BigInt::from_int(456);
    let sum = a.add(&b);
    let s = sum.to_string();
    assert(s[0] == '5' && s[1] == '7' && s[2] == '9', "123+456=579");
    free(s);
}

test "BigInt Add With Carry" {
    let a = BigInt::from_int(999);
    let b = BigInt::from_int(1);
    let sum = a.add(&b);
    let s = sum.to_string();
    assert(s[0] == '1' && s[1] == '0' && s[2] == '0' && s[3] == '0', "999+1=1000");
    free(s);
}

test "BigInt Add Large" {
    let a = BigInt::from_int(999999);
    let b = BigInt::from_int(1);
    let sum = a.add(&b);
    let s = sum.to_string();
    assert(s[0] == '1' && s[1] == '0' && s[2] == '0' && s[3] == '0' && s[4] == '0' && s[5] == '0' && s[6] == '0', "999999+1=1000000");
    free(s);
}

test "BigInt Clone" {
    let a = BigInt::from_int(42);
    let b = a.clone();
    let sa = a.to_string();
    let sb = b.to_string();
    assert(sa[0] == '4' && sb[0] == '4', "clone equal");
    free(sa);
    free(sb);
}

test "BigInt Compare" {
    let a = BigInt::from_int(123);
    let b = BigInt::from_int(456);
    assert(a.compare(&b) == -1, "123 < 456");
    assert(b.compare(&a) == 1, "456 > 123");
    let c = BigInt::from_int(456);
    assert(b.compare(&c) == 0, "456 == 456");
    let big = BigInt::from_int(1000);
    assert(big.compare(&a) == 1, "1000 > 123");
}

test "BigInt FromString" {
    let r = BigInt::from_string("987654321");
    assert(r.is_ok(), "from_string valid");
    let v = r.unwrap();
    let s = v.to_string();
    assert(s[0] == '9' && s[1] == '8' && s[2] == '7', "from_string digits");
    free(s);

    let r2 = BigInt::from_string("12x");
    assert(r2.is_err(), "from_string invalid digit");
    let r3 = BigInt::from_string("");
    assert(r3.is_err(), "from_string empty");
    let r4 = BigInt::from_string("-5");
    assert(r4.is_err(), "from_string negative rejected");
}

test "BigInt Sub" {
    let a = BigInt::from_int(456);
    let b = BigInt::from_int(123);
    let d = a.sub(&b);
    let s = d.to_string();
    assert(s[0] == '3' && s[1] == '3' && s[2] == '3', "456-123=333");
    free(s);

    let x = BigInt::from_int(1000);
    let y = BigInt::from_int(1);
    let z = x.sub(&y);
    let zs = z.to_string();
    assert(zs[0] == '9' && zs[1] == '9' && zs[2] == '9', "1000-1=999");
    free(zs);
}

test "BigInt Mul" {
    let a = BigInt::from_int(99);
    let b = BigInt::from_int(99);
    let m = a.mul(&b);
    let s = m.to_string();
    assert(s[0] == '9' && s[1] == '8' && s[2] == '0' && s[3] == '1', "99*99=9801");
    free(s);

    let c = BigInt::from_int(12345);
    let d = BigInt::from_int(0);
    let z = c.mul(&d);
    let zs = z.to_string();
    assert(zs[0] == '0' && zs[1] == 0, "x*0=0");
    free(zs);
}

test "BigInt DivRem" {
    let a = BigInt::from_int(100);
    let b = BigInt::from_int(7);
    let q = a.div(&b);
    let qs = q.to_string();
    assert(qs[0] == '1' && qs[1] == '4', "100/7=14");
    free(qs);
    let rm = a.rem(&b);
    let rms = rm.to_string();
    assert(rms[0] == '2' && rms[1] == 0, "100%7=2");
    free(rms);

    let x = BigInt::from_int(7);
    let y = BigInt::from_int(100);
    let q2 = x.div(&y);
    let q2s = q2.to_string();
    assert(q2s[0] == '0' && q2s[1] == 0, "7/100=0");
    free(q2s);
    let rm2 = x.rem(&y);
    let rm2s = rm2.to_string();
    assert(rm2s[0] == '7' && rm2s[1] == 0, "7%100=7");
    free(rm2s);
}
