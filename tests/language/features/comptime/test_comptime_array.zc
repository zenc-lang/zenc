// comptime: array computation and code emission
comptime {
    let n = 6;
    let fib: int[6];
    fib[0] = 0;
    fib[1] = 1;
    for let i = 2; i < n; i += 1 {
        fib[i] = fib[i - 1] + fib[i - 2];
    }
    code("let fibs: int[6] = [");
    for let i = 0; i < n; i += 1 {
        code(fib[i]);
        if (i < n - 1) code(", ");
    }
    code("];\n");
}

test "comptime arrays" {
    expect_eq(fibs[0], 0, "fibs[0] should be 0");
    expect_eq(fibs[1], 1, "fibs[1] should be 1");
    expect_eq(fibs[2], 1, "fibs[2] should be 1");
    expect_eq(fibs[3], 2, "fibs[3] should be 2");
    expect_eq(fibs[5], 5, "fibs[5] should be the 5th fibonacci number");
}
